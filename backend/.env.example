# Copy this file to .env and fill in your own values. .env is gitignored and
# must never be committed. Nothing in THIS file may be a real credential.

# Recommended for Supabase hosted projects: copy the Session pooler connection
# string from Project Settings > Database > Connection pooling.
SUPABASE_DB_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:5432/postgres

# Direct connections also work when your environment supports IPv6 or your
# Supabase project has the IPv4 add-on:
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Signs and verifies login tokens. Anyone who knows this value can mint a valid
# session for any account, so generate a long random string per environment.
JWT_SECRET=[GENERATE-A-LONG-RANDOM-STRING]

# Supabase requires SSL for hosted Postgres. Set DB_SSL=false only for a local
# Postgres database.
DB_SSL=true

# Used for problem photo and video uploads. Create a public Supabase Storage
# bucket named to match SUPABASE_STORAGE_BUCKET.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=problem-media

# Optional. Turns on the matching agent (backend/lib/agent.js), which re-reads
# the keyword shortlist and decides which startups actually solve a problem,
# and searches the web when the directory has no answer. Leave unset and
# matching falls back to keyword overlap alone.
OPENAI_API_KEY=
# Optional override for the model the agent runs on.
OPENAI_MATCH_MODEL=gpt-5
