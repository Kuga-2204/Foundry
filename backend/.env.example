# Copy this file to backend/.env and fill in real local/deploy values.

# Supabase hosted Postgres connection string.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

JWT_SECRET=change-me-before-deploying

# Supabase requires SSL for hosted Postgres. Set DB_SSL=false only for a local
# Postgres database.
DB_SSL=true

SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=problem-media

# AI Assist uses this on the backend only. Never expose it in frontend env.
OPENAI_API_KEY=your-openai-api-key
AI_ASSIST_MODEL=gpt-4o-mini